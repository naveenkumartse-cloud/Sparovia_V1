# Backend Environment Configuration Example

# API URLs
FrontendUrl=http://localhost:3000

# Database
ConnectionStrings__DefaultConnection="Host=localhost;Database=sparovia_db;Username=postgres;Password=your_password_here;Pooling=true;SslMode=VerifyFull"
ConnectionStrings__TestConnection="Host=localhost;Database=sparovia_test_db;Username=postgres;Password=your_password_here;Pooling=true"
Storage__Provider=Local
Storage__BasePath=./wwwroot/uploads
