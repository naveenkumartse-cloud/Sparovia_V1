# Sparovia Backend — Environment Variables Reference
# Copy this file and fill in real values. NEVER commit real credentials.

# PostgreSQL Connection
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=your-host;Port=5432;Database=sparovia;Username=your-user;Password=your-password

# JWT
JWT__SECRET=your-strong-jwt-secret-at-least-32-characters-long
JWT__ISSUER=sparovia-api
JWT__AUDIENCE=sparovia-client
JWT__EXPIRYMINUTES=60

# CORS
CORS__ALLOWEDORIGINS__0=https://your-frontend-domain.com

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://+:443
