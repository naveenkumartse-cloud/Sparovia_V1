{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "AllowedHosts":  "*",
    "AdminUrl": "http://localhost:3001",
    "PublicUrl": "http://localhost:3000",
    "Cors":  {
                 "AllowedOrigins":  [
                                        "http://localhost:3000",
                                        "http://localhost:3001"
                                    ]
             },
    "AI": {
        "Provider": "Stub",
        "DefaultModel": "sparovia-v1-default",
        "TimeoutSeconds": 30,
        "MaxRetries": 2,
        "RateLimitPerMinute": 20
    }
}
