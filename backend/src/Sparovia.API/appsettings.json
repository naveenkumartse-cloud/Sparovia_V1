{
    "ConnectionStrings": {
        "DefaultConnection": ""
    },
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "AllowedHosts":  "*",
    "AdminUrl": "http://localhost:3001",
    "PublicUrl": "http://localhost:3000",
    "Cors":  {
                 "AllowedOrigins":  [
                                        "http://localhost:3000",
                                        "http://localhost:3001"
                                    ]
             },
    "AI": {
        "Provider": "Stub",
        "DefaultModel": "sparovia-v1-default",
        "TimeoutSeconds": 30,
        "MaxRetries": 2,
        "RateLimitPerMinute": 20
    },
    "ImageUpload": {
        "MaxFileSizeBytes": 10485760,
        "MinWidth": 100,
        "MinHeight": 100,
        "MaxWidth": 10000,
        "MaxHeight": 10000,
        "MaxPixelCount": 50000000
    }
}
